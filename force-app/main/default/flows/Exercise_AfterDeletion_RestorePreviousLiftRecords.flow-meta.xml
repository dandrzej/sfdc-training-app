                <numberValue>0.0</numberValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Reps_of_max_weight__c</field>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.Lift__r</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>UPD_UpdateLift_MaxFromPrevious</name>
        <label>Update Lift Max Weight from Previous Result</label>
        <locationX>402</locationX>
        <locationY>1343</locationY>
        <inputAssignments>
            <field>MMax_weight__c</field>
            <value>
                <elementReference>previousMaxWeight</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Reps_of_max_weight__c</field>
            <value>
                <elementReference>previousRepsOfMaxWeight</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Lift__r</inputReference>
    </recordUpdates>
