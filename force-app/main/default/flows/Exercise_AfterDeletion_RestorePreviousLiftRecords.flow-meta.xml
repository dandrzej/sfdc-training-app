        <locationX>226</locationX>
        <locationY>611</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>GET_Exercises_PreviousMaxCandidates</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Lift__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Lift__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Exercise__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Weight__c</queriedFields>
        <sortField>Weight__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GET_Exercises_PreviousMaxCandidates</name>
        <label>Get Previous Max Candidate Exercises</label>
        <locationX>226</locationX>
        <locationY>719</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>DEC_IsPreviousLiftMaxEmpty</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Lift__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Lift__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Weight__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>GET_Exercise_CurrentMax_ByLift.Weight__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Exercise__c</object>
        <sortField>Weight__c</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>GET_Lift_ById</name>
        <label>Get Lift By Id</label>
        <locationX>446</locationX>
        <locationY>287</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>UPD_DecrementLift_TrainingCount</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Lift__r.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lift__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>UPD_DecrementLift_TrainingCount</name>
        <label>Decrement Lift Training Count</label>
        <locationX>446</locationX>
        <locationY>395</locationY>
        <connector>
            <targetReference>DEC_IsDeletingCurrentMaxWeight</targetReference>
        </connector>
        <inputAssignments>
