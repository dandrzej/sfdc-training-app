            <value>
                <elementReference>FML_LiftTrainings_Decremented</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record.Lift__r</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>UPD_SetLift_MaxToZero</name>
