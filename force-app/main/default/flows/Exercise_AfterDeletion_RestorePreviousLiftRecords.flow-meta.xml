<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>ASN_SetPreviousLiftMaxValues</name>
        <label>SET previous Lift.MaxWeight Variable</label>
        <locationX>490</locationX>
        <locationY>1151</locationY>
        <assignmentItems>
            <assignToReference>previousRepsOfMaxWeight</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LOOP_PreviousLiftMaxResults.Number_of_reps__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>previousMaxWeight</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>LOOP_PreviousLiftMaxResults.Weight__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>LOOP_PreviousLiftMaxResults</targetReference>
        </connector>
    </assignments>
    <collectionProcessors>
        <name>COL_SortPreviousLiftMaxResults_ByWeightDesc</name>
        <elementSubtype>SortCollectionProcessor</elementSubtype>
        <label>Sort Previous Lift Results by Weight Desc</label>
        <locationX>402</locationX>
        <locationY>935</locationY>
        <collectionProcessorType>SortCollectionProcessor</collectionProcessorType>
        <collectionReference>GET_Exercises_PreviousMaxCandidates</collectionReference>
        <connector>
            <targetReference>LOOP_PreviousLiftMaxResults</targetReference>
        </connector>
        <limit>1</limit>
        <sortOptions>
            <doesPutEmptyStringAndNullFirst>false</doesPutEmptyStringAndNullFirst>
            <sortField>Weight__c</sortField>
            <sortOrder>Desc</sortOrder>
        </sortOptions>
        <sortOptions>
            <doesPutEmptyStringAndNullFirst>false</doesPutEmptyStringAndNullFirst>
            <sortField>Number_of_reps__c</sortField>
            <sortOrder>Desc</sortOrder>
        </sortOptions>
    </collectionProcessors>
    <decisions>
        <name>DEC_IsDeletingCurrentMaxWeight</name>
        <label>IS Removing Current Max Weight ?</label>
        <locationX>446</locationX>
        <locationY>503</locationY>
        <defaultConnectorLabel>n</defaultConnectorLabel>
        <rules>
            <name>OUT_IsDeletingCurrentMaxWeight_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Weight__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>GET_Lift_ById.MMax_weight__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Number_of_reps__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>GET_Lift_ById.Reps_of_max_weight__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GET_Exercise_CurrentMax_ByLift</targetReference>
            </connector>
            <label>Deleting current max weight</label>
        </rules>
    </decisions>
    <decisions>
        <name>DEC_IsPreviousLiftMaxEmpty</name>
        <label>IS previous MAX Lift.MaxWeight NULL?</label>
        <locationX>226</locationX>
        <locationY>827</locationY>
        <defaultConnector>
            <targetReference>COL_SortPreviousLiftMaxResults_ByWeightDesc</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>n</defaultConnectorLabel>
        <rules>
            <name>OUT_NoPreviousMax</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GET_Exercises_PreviousMaxCandidates</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>UPD_SetLift_MaxToZero</targetReference>
            </connector>
            <label>No Previous Max Found</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>FML_LiftTrainings_Decremented</name>
        <dataType>Number</dataType>
        <expression>{!GET_Lift_ById.Number_of_trainings__c} - 1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Lift {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Exercise - After Delete - Update Lift Max Metrics</label>
    <loops>
        <name>LOOP_PreviousLiftMaxResults</name>
        <label>Max results loop</label>
        <locationX>402</locationX>
        <locationY>1043</locationY>
        <collectionReference>GET_Exercises_PreviousMaxCandidates</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>ASN_SetPreviousLiftMaxValues</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>UPD_UpdateLift_MaxFromPrevious</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GET_Exercise_CurrentMax_ByLift</name>
