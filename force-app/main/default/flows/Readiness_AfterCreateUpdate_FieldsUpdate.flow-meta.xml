    <formulas>
        <name>FML_DaylightSavingIndicator</name>
        <dataType>Number</dataType>
        <expression>IF(
  OR(
    MONTH(DATEVALUE($Flow.CurrentDateTime)) &lt; 3,
    MONTH(DATEVALUE($Flow.CurrentDateTime)) &gt; 10
  ),
  1,
  IF(
    AND(
      MONTH(DATEVALUE($Flow.CurrentDateTime)) &gt; 3,
      MONTH(DATEVALUE($Flow.CurrentDateTime)) &lt; 10
    ),
    /* Apr–Sep → Summer */
    2,
    /* March or October → compute boundary Sundays */
    IF(
      /* MARCH boundary: last Sunday of March */
      MONTH(DATEVALUE($Flow.CurrentDateTime)) = 3,
      IF(
        DAY(DATEVALUE($Flow.CurrentDateTime)) &gt;=
        31 - (WEEKDAY(DATE(YEAR(DATEVALUE($Flow.CurrentDateTime)), 3, 31)) - 1),
        2, /* On/after last Sunday in March → Summer */
        1  /* Before last Sunday in March → Winter */
      ),
      /* OCTOBER boundary: last Sunday of October */
      IF(
        DAY(DATEVALUE($Flow.CurrentDateTime)) &lt;
        31 - (WEEKDAY(DATE(YEAR(DATEVALUE($Flow.CurrentDateTime)), 10, 31)) - 1),
        2, /* Before last Sunday in October → Summer */
        1  /* On/after last Sunday in October → Winter */
      )
    )
  )
)</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>converts sfdc date to dd.mm.yyyy format</description>
        <name>FML_Readiness_DisplayName</name>
        <dataType>String</dataType>
        <expression>CASE(WEEKDAY(DATEVALUE({!$Record.CreatedDate})),1, &apos;Niedziela&apos;,2,&apos;Poniedziałek&apos;,3,&apos;Wtorek&apos;,4,&apos;Środa&apos;,5,&apos;Czwartek&apos;,6,&apos;Piątek&apos;,7,&apos;Sobota&apos;,&apos;Błąd daty&apos;) + &apos; - &apos; +
TEXT(HOUR(TIMEVALUE({!$Record.CreatedDate}))+{!FML_DaylightSavingIndicator})+ &quot;:&quot;+
IF(LEN(TEXT(MINUTE(TIMEVALUE({!$Record.CreatedDate})))) = 1, &apos;0&apos;+TEXT(MINUTE(TIMEVALUE({!$Record.CreatedDate}))) , TEXT(MINUTE(TIMEVALUE({!$Record.CreatedDate}))))</expression>
    </formulas>
